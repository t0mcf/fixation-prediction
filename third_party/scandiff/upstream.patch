 import json
 
 
+class ChunkedFeatureLoader:
+    """Load image features from chunked .pth files with an index.
+    Prefers memory-mapped .npy if available (created by convert_features_to_memmap.py).
+    Falls back to chunked .pth, then individual .pth files."""
+
+    def __init__(self, features_dir):
+        self.features_dir = Path(features_dir)
+        memmap_index_path = self.features_dir / "memmap_index.json"
+        if memmap_index_path.exists():
+            with open(memmap_index_path) as f:
+                meta = json.load(f)
+            self.memmap = np.memmap(
+                self.features_dir / "features.npy",
+                dtype=meta["dtype"], mode="r",
+                shape=tuple(meta["shape"]),
+            )
+            self.memmap_idx = meta["index"]
+            self.mode = "memmap"
+        else:
+            index_path = self.features_dir / "index.json"
+            if index_path.exists():
+                with open(index_path) as f:
+                    self.index = json.load(f)
+                self.mode = "chunked"
+            else:
+                self.mode = "individual"
+            self._cache_name = None
+            self._cache_data = None
+
+    def load(self, stem):
+        if self.mode == "memmap":
+            row = self.memmap_idx[stem]
+            return torch.from_numpy(self.memmap[row].copy()).float()
+        if self.mode == "individual":
+            return torch.load(self.features_dir / f"{stem}.pth", weights_only=True)
+        chunk_name = self.index[stem]
+        if chunk_name != self._cache_name:
+            self._cache_data = torch.load(self.features_dir / chunk_name, weights_only=True)
+            self._cache_name = chunk_name
+        return self._cache_data[stem]
+
 
